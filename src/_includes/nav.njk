{% macro navBallButton(htmlId, ariaLabel) %}
{# Gemeinsame Hülle aller drei Nav-Kugeln: Button + .nav-ball-visual +
   das immer gleiche id="X-toggle"/aria-expanded-Muster. Der Inhalt des
   <span> (das jeweilige Icon) kommt über {% call %} von außen rein -
   nur DAS unterscheidet sich zwischen den Kugeln strukturell, der Rest
   war bisher dreimal fast identisch dupliziert. Das Dropdown selbst
   bleibt bewusst AUSSERHALB dieses Macros: Kontakt/Sprache/Menü haben
   inhaltlich zu unterschiedliche Dropdowns (statische Links, Schleife
   über Sprachen, data-nav-links-Attribut), um sie sinnvoll zu
   vereinheitlichen. #}
<button class="nav-ball" id="{{ htmlId }}-toggle" aria-label="{{ ariaLabel }}" aria-expanded="false">
  <span class="nav-ball-visual">{{ caller() }}</span>
</button>
{% endmacro %}

