---
layout: layout.njk
page_key: imprint
pagination:
  data: languageList
  size: 1
  alias: lang
permalink: "{{ pages.imprint[lang] }}"
---
{% set t = de %}
{% if lang == "en" %}{% set t = en %}{% endif %}
{% if lang == "nl" %}{% set t = nl %}{% endif %}
<section class="reveal-section tone-paper visible">
  <div class="section-inner">
    <div class="eyebrow-row">
      <span class="mono-label wine-label">{{ t.imprint.eyebrow }}</span>
      <span class="eyebrow-line"></span>
    </div>
    <h1 class="section-title">{{ t.imprint.title }}</h1>

    <div class="prose-block">
      <p class="prose-paragraph">{{ t.imprint.intro }}</p>
    </div>

    <div class="legal-block">
      <p class="legal-block-title">{{ t.imprint.provider_title }}</p>
      <div class="prose-block">
        <p class="prose-paragraph">{{ t.imprint.provider_address | safe }}</p>
      </div>
    </div>

    <div class="legal-block">
      <p class="legal-block-title">{{ t.imprint.responsible_title }}</p>
      <div class="prose-block">
        <p class="prose-paragraph">{{ t.imprint.responsible_address | safe }}</p>
      </div>
    </div>

    <div class="legal-block">
      <p class="legal-block-title">{{ t.imprint.contact_title }}</p>
      <div data-email-contact-theme="light" data-copy-label="{{ t.nav.copy_button }}" data-copied-label="{{ t.nav.copied_button }}"></div>
      <div data-phone-2-contact-theme="light" data-copy-label="{{ t.nav.copy_phone_button }}" data-copied-label="{{ t.nav.copied_button }}"></div>
    </div>

    <div class="legal-block">
      <p class="legal-block-title">{{ t.imprint.liability_content_title }}</p>
      <div class="prose-block">
        <p class="prose-paragraph">{{ t.imprint.liability_content_text }}</p>
      </div>
    </div>

    <div class="legal-block">
      <p class="legal-block-title">{{ t.imprint.liability_links_title }}</p>
      <div class="prose-block">
        <p class="prose-paragraph">{{ t.imprint.liability_links_text }}</p>
      </div>
    </div>

    <div class="legal-block">
      <p class="legal-block-title">{{ t.imprint.copyright_title }}</p>
      <div class="prose-block">
        <p class="prose-paragraph">{{ t.imprint.copyright_text }}</p>
      </div>
    </div>

    <div class="legal-block">
      <p class="legal-block-title">{{ t.imprint.dispute_title }}</p>
      <div class="prose-block">
        <p class="prose-paragraph">{{ t.imprint.dispute_text }}</p>
      </div>
    </div>
  </div>
</section>