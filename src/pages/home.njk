---
layout: layout.njk
page_key: home
pagination:
  data: languageList
  size: 1
  alias: lang
permalink: "{{ pages.home[lang] }}"
---
{#
  EIN Template statt drei: "pagination" läuft languageList.js (["de","en","nl"])
  durch und erzeugt für jeden Eintrag eine eigene Ausgabedatei - der jeweilige
  Wert landet in der Variable "lang" (weil "alias: lang"). "permalink" nutzt
  dieselbe pages.json wie der Sprachumschalter, damit die Zuordnung
  Sprache -> URL nur an EINER Stelle im Projekt gepflegt werden muss.

  STRUKTUR (überarbeitete Fassung):
  1. Hero
  2. section-home-details  (Zuhause / Haus, Fotos, Akkordeon mit Praktischem)
  3. section-rooms         (fünf Zimmer, Fotos)
  4. section-hosts         (Gastgeber, Fotos)
  5. section-area          (Zell & Umgebung, Akkordeon + Häufige Fragen)
  6. section-contact
#}
{% set t = de %}
{% if lang == "en" %}{% set t = en %}{% endif %}
{% if lang == "nl" %}{% set t = nl %}{% endif %}

<header class="hero">
  <div class="ambient-bg ambient-bg--hero" aria-hidden="true">
    <div class="ambient-layer ambient-layer-1"></div>
    <div class="ambient-layer ambient-layer-2"></div>
    <div class="ambient-layer ambient-layer-3"></div>
    <div class="ambient-layer ambient-layer-4"></div>
    <div class="ambient-layer ambient-layer-5"></div>
  </div>

  <div class="hero-grid">

    <div class="hero-text" id="hero-content">
      <div class="eyebrow-row hero-eyebrow-row">
        <span class="mono-label wine-label">{{ t.home.hero.eyebrow }}</span>
        <span class="eyebrow-line"></span>
      </div>

      <h1 class="hero-heading">
        {{ t.home.hero.title_line1 }}<br />
        <span class="hero-heading-italic">{{ t.home.hero.title_line2 }}</span>
      </h1>
      <div class="prose-block">
        <p class="prose-paragraph">{{ t.home.hero.sub }}</p>
      </div>

      <div class="hero-scroll-hint">
        <span class="mono-label">{{ t.home.hero.scroll_hint }}</span>
        <span class="eyebrow-line"></span>
      </div>
    </div>
{#
    <div class="hero-media crossfade-group" data-interval="7500">
      <img class="crossfade-img active" src="{{ '/assets/media/Hero/Haus_3x4_1.jpg' | url }}" alt="" />
      <img class="crossfade-img" src="{{ '/assets/media/Hero/Haus_3x4_2.jpg' | url }}" alt="" />
      <img class="crossfade-img" src="{{ '/assets/media/Hero/Haus_3x4_3.jpg' | url }}" alt="" />
      <img class="crossfade-img" src="{{ '/assets/media/Hero/Haus_3x4_4.jpg' | url }}" alt="" />
    </div> #}
    <div class="hero-media">
      <video id="hero_Video_loop" class="hero_Video_loop" autoplay muted loop playsinline poster="{{ '/assets/media/Hero/Haus_3x4_1.jpg' | url }}">
        <source src="{{ '/assets/media/Hero/hero_Video_loop.mp4' | url }}" type="video/mp4">
      </video>
    </div>
  </div>
</header>


<!-- 2. Zuhause / Haus: Text, fünf Fotos, Akkordeon mit Praktischem -->
<section id="section-home-details" class="reveal-section tone-paper" data-reveal>
  <div class="section-inner">
    <div class="fade-item eyebrow-row">
      <span class="mono-label wine-label">{{ t.home.home_details.eyebrow }}</span>
      <span class="eyebrow-line"></span>
    </div>
    <h2 class="fade-item section-title">{{ t.home.home_details.title_line1 }}<br /><span class="section-title-line2">{{ t.home.home_details.title_line2 }}</span></h2>
    <div class="fade-item">
      <div class="prose-block mb-gallery-intro">
        {% for p in t.home.home_details.text %}
        <p class="prose-paragraph">{{ p }}</p>
        {% endfor %}
      </div>

      <div class="photo-grid" data-photo-grid="Haus, Info, Garten, Eingangsbereich, Frühstücksraum, Treppenhaus" data-photo-labels='{{ t.home.home_details.photo_labels | dump }}' data-photo-infos='{{ t.home.home_details.photo_infos | dump }}' data-photo-info-tiles='{{ t.home.home_details.info_tiles | dump }}'></div>

      <div class="accordion">
        {% for entry in t.home.home_details.accordion %}
        <div class="accordion-item">
          <h3>
            <button
              type="button"
              class="accordion-trigger"
              aria-expanded="false"
              aria-controls="accordion-panel-details-{{ loop.index }}"
              id="accordion-trigger-details-{{ loop.index }}"
            >
              <span class="accordion-trigger-label mono-label">{{ entry.title }}</span>
              <span class="accordion-icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div
            class="accordion-panel"
            id="accordion-panel-details-{{ loop.index }}"
            role="region"
            aria-labelledby="accordion-trigger-details-{{ loop.index }}"
            aria-hidden="true"
          >
            <div class="accordion-panel-inner">
              <div class="accordion-panel-body">
                <p class="accordion-panel-content">{{ entry.content | safe }}</p>
                {% if entry.images %}
                <div class="accordion-panel-images">
                  {% for img in entry.images %}
                  <img class="accordion-panel-image" src="{{ img.src | url }}" alt="{{ img.alt }}" />
                  {% endfor %}
                </div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>


<!-- 3. Zimmer: Text, fünf Fotos -->
<section id="section-rooms" class="reveal-section tone-cloud" data-reveal>
  <div class="ambient-bg" aria-hidden="true">
    <div class="ambient-layer ambient-layer-1"></div>
    <div class="ambient-layer ambient-layer-2"></div>
    <div class="ambient-layer ambient-layer-3"></div>
    <div class="ambient-layer ambient-layer-4"></div>
    <div class="ambient-layer ambient-layer-5"></div>
  </div>
  <div class="section-inner">
    <div class="fade-item eyebrow-row">
      <span class="mono-label wine-label">{{ t.home.rooms.eyebrow }}</span>
      <span class="eyebrow-line"></span>
    </div>
    <h2 class="fade-item section-title">{{ t.home.rooms.title_line1 }}<br /><span class="section-title-line2">{{ t.home.rooms.title_line2 }}</span></h2>
    <div class="fade-item">
      <div class="prose-block mb-gallery-intro">
        {% for p in t.home.rooms.text %}
        <p class="prose-paragraph">{{ p }}</p>
        {% endfor %}
      </div>

      <div class="photo-grid" data-photo-grid="Zimmer_1, Zimmer_2, Zimmer_3, Zimmer_4, Zimmer_5" data-photo-labels='{{ t.home.rooms.photo_labels | dump }}' data-photo-infos='{{ t.home.rooms.photo_infos | dump }}'></div>
    </div>
  </div>
</section>


<!-- 4. Gastgeber: Text, drei Fotos -->
<section id="section-hosts" class="reveal-section tone-paper" data-reveal>
  <div class="section-inner">
    <div class="fade-item eyebrow-row">
      <span class="mono-label wine-label">{{ t.home.hosts.eyebrow }}</span>
      <span class="eyebrow-line"></span>
    </div>
    <h2 class="fade-item section-title">{{ t.home.hosts.title_line1 }}<br /><span class="section-title-line2">{{ t.home.hosts.title_line2 }}</span></h2>
    <div class="fade-item">
      <div class="prose-block mb-gallery-intro">
        {% for p in t.home.hosts.text %}
        <p class="prose-paragraph">{{ p }}</p>
        {% endfor %}
      </div>

      <div class="photo-grid photo-grid-plain" data-photo-grid="Rosa, Info, Bjorn, Romina" data-photo-labels='{{ t.home.hosts.photo_labels | dump }}' data-photo-infos='{{ t.home.hosts.photo_infos | dump }}' data-photo-info-tiles='{{ t.home.hosts.info_tiles | dump }}'></div>
    </div>
  </div>
</section>


<!-- 5. Zell & Umgebung: Text, Akkordeon, Häufige Fragen -->
<section id="section-area" class="reveal-section tone-cloud" data-reveal>
  <div class="ambient-bg" aria-hidden="true">
    <div class="ambient-layer ambient-layer-1"></div>
    <div class="ambient-layer ambient-layer-2"></div>
    <div class="ambient-layer ambient-layer-3"></div>
    <div class="ambient-layer ambient-layer-4"></div>
    <div class="ambient-layer ambient-layer-5"></div>
  </div>
  <div class="section-inner">
    <div class="fade-item eyebrow-row">
      <span class="mono-label wine-label">{{ t.home.area.eyebrow }}</span>
      <span class="eyebrow-line"></span>
    </div>
    <h2 class="fade-item section-title">{{ t.home.area.title_line1 }}<br /><span class="section-title-line2">{{ t.home.area.title_line2 }}</span></h2>
    <div class="fade-item">
      <div class="prose-block">
        {% for p in t.home.area.text %}
        <p class="prose-paragraph">{{ p }}</p>
        {% endfor %}
      </div>

      <div class="accordion">
        {% for entry in t.home.area.accordion %}
        <div class="accordion-item">
          <h3>
            <button
              type="button"
              class="accordion-trigger"
              aria-expanded="false"
              aria-controls="accordion-panel-area-{{ loop.index }}"
              id="accordion-trigger-area-{{ loop.index }}"
            >
              <span class="accordion-trigger-label mono-label">{{ entry.title }}</span>
              <span class="accordion-icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div
            class="accordion-panel"
            id="accordion-panel-area-{{ loop.index }}"
            role="region"
            aria-labelledby="accordion-trigger-area-{{ loop.index }}"
            aria-hidden="true"
          >
            <div class="accordion-panel-inner">
              <div class="accordion-panel-body">
                <p class="accordion-panel-content">{{ entry.content | safe }}</p>
                {% if entry.images %}
                <div class="accordion-panel-images">
                  {% for img in entry.images %}
                  <img class="accordion-panel-image" src="{{ img.src | url }}" alt="{{ img.alt }}" />
                  {% endfor %}
                </div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
        {% endfor %}

        {# ---------- Häufige Fragen (FAQ) ----------
           EIN zusätzlicher Akkordeon-Eintrag auf derselben Ebene wie
           "Stadt", "Wandern" usw. - kein eigener Abschnitt, kein
           verschachteltes Akkordeon. Beim Öffnen stehen alle Fragen mit
           Antworten einfach untereinander im selben Panel (eigene
           Klassen .faq-entry/.faq-question/.faq-answer statt einer
           Mischung aus .mono-label + .accordion-panel-content, um
           Konflikte in der CSS-Kaskade zu vermeiden). Der Eintrag wird
           übersprungen, falls in einer Sprachdatei noch kein
           "faq"-Objekt existiert (z.B. während en.json/nl.json noch
           nachgezogen werden). #}
        {% if t.home.area.faq %}
        <div class="accordion-item">
          <h3>
            <button
              type="button"
              class="accordion-trigger"
              aria-expanded="false"
              aria-controls="accordion-panel-area-faq"
              id="accordion-trigger-area-faq"
            >
              <span class="accordion-trigger-label mono-label">{{ t.home.area.faq.heading }}</span>
              <span class="accordion-icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div
            class="accordion-panel"
            id="accordion-panel-area-faq"
            role="region"
            aria-labelledby="accordion-trigger-area-faq"
            aria-hidden="true"
          >
            <div class="accordion-panel-inner">
              <div class="accordion-panel-body">
                {% for entry in t.home.area.faq.items %}
                <div class="faq-entry">
                  <p class="faq-question">{{ entry.title }}</p>
                  <p class="faq-answer">{{ entry.content }}</p>
                </div>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>


<!-- 6. Kontakt -->
<section id="section-contact" class="contact">
  <div class="section-inner">
    <div class="eyebrow-row">
      <span class="mono-label light-gold-label">{{ t.home.contact.eyebrow }}</span>
      <span class="eyebrow-line light-line"></span>
    </div>
    <h2 class="section-title contact-title">{{ t.home.contact.title }}</h2>
    <p class="contact-text">{{ t.home.contact.text | safe }}</p>
    <div data-email-contact-theme="dark" data-copy-label="{{ t.nav.copy_button }}" data-copied-label="{{ t.nav.copied_button }}"></div>
    <div data-phone-contact-theme="dark" data-copy-label="{{ t.nav.copy_phone_button }}" data-copied-label="{{ t.nav.copied_button }}"></div>
    <div data-phone-2-contact-theme="dark" data-copy-label="{{ t.nav.copy_phone_button }}" data-copied-label="{{ t.nav.copied_button }}"></div>
    <p class="contact-hint">{{ t.home.contact.hint }}</p>
  </div>
</section>